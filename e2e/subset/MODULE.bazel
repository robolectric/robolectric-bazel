bazel_dep(name = "rules_robolectric", version = "0.0.0", repo_name = "robolectric_repo")
local_path_override(
    module_name = "rules_robolectric",
    path = "../..",
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_jvm_external", version = "6.9")

bazel_dep(name = "hermetic_android_toolchains", version = "0.3.0", dev_dependency = True)
bazel_dep(name = "rules_android", version = "0.7.3", dev_dependency = True)

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    aar_import_bzl_label = "@rules_android//rules:rules.bzl",
    artifacts = [
        "junit:junit:4.13.2",
        "org.robolectric:robolectric:4.17",
    ],
    repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
    use_starlark_android_rules = True,
)
use_repo(maven, "maven")

android = use_extension("@hermetic_android_toolchains//:extensions.bzl", "android", dev_dependency = True)
android.sdk(
    build_tools_version = "37.0.0",
    version = "37.0",
)
use_repo(android, "androidsdk")

# Make @rules_android's @androidsdk labels resolve to the hermetic SDK.
rules_android_sdk = use_extension("@rules_android//rules/android_sdk_repository:rule.bzl", "android_sdk_repository_extension", dev_dependency = True)

override_repo(rules_android_sdk, "androidsdk")

register_toolchains(
    "@androidsdk//:all",
    dev_dependency = True,
)

bazel_dep(name = "bazel_skylib", version = "1.9.0", dev_dependency = True)
bazel_dep(name = "rules_python", version = "0.40.0", dev_dependency = True)

bazel_dep(name = "selection_dependency", version = "0.0.0")
local_path_override(
    module_name = "selection_dependency",
    path = "../dependency",
)

robolectric_repo = use_extension("@robolectric_repo//bazel:extensions.bzl", "robolectric_repository_extensions")

# Deliberately request versions out of catalog order.
robolectric_repo.configure(versions = [
    "15-robolectric-13954326-i7",
    "14-robolectric-10818077-i7",
])

# An excluded repository must stay unfetched, even with a warm Bazel cache.
unavailable_runtime = use_repo_rule("@robolectric_repo//tests:unavailable_runtime.bzl", "unavailable_runtime")

unavailable_runtime(name = "excluded_runtime")

override_repo(
    robolectric_repo,
    org_robolectric_android_all_instrumented_10_robolectric_5803371_i7 = "excluded_runtime",
    org_robolectric_android_all_instrumented_11_robolectric_6757853_i7 = "excluded_runtime",
    org_robolectric_android_all_instrumented_12_1_robolectric_8229987_i7 = "excluded_runtime",
    org_robolectric_android_all_instrumented_12_robolectric_7732740_i7 = "excluded_runtime",
    org_robolectric_android_all_instrumented_13_robolectric_9030017_i7 = "excluded_runtime",
    org_robolectric_android_all_instrumented_16_robolectric_13921718_i7 = "excluded_runtime",
    org_robolectric_android_all_instrumented_17_robolectric_15733970_i7 = "excluded_runtime",
    org_robolectric_android_all_instrumented_6_0_1_r3_robolectric_r1_i7 = "excluded_runtime",
    org_robolectric_android_all_instrumented_7_0_0_r1_robolectric_r1_i7 = "excluded_runtime",
    org_robolectric_android_all_instrumented_7_1_0_r7_robolectric_r1_i7 = "excluded_runtime",
    org_robolectric_android_all_instrumented_8_0_0_r4_robolectric_r1_i7 = "excluded_runtime",
    org_robolectric_android_all_instrumented_8_1_0_robolectric_4611349_i7 = "excluded_runtime",
    org_robolectric_android_all_instrumented_9_robolectric_4913185_2_i7 = "excluded_runtime",
)
