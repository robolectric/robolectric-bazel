bazel_dep(name = "rules_robolectric", version = "0.0.0", repo_name = "robolectric_repo")
local_path_override(
    module_name = "rules_robolectric",
    path = "../..",
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_jvm_external", version = "6.9")

bazel_dep(name = "hermetic_android_toolchains", version = "0.3.0", dev_dependency = True)
bazel_dep(name = "rules_android", version = "0.7.3", dev_dependency = True)

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    aar_import_bzl_label = "@rules_android//rules:rules.bzl",
    artifacts = [
        "junit:junit:4.13.2",
        "org.robolectric:robolectric:4.17",
    ],
    repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
    use_starlark_android_rules = True,
)
use_repo(maven, "maven")

android = use_extension("@hermetic_android_toolchains//:extensions.bzl", "android", dev_dependency = True)
android.sdk(
    build_tools_version = "37.0.0",
    version = "37.0",
)
use_repo(android, "androidsdk")

# Make @rules_android's @androidsdk labels resolve to the hermetic SDK.
rules_android_sdk = use_extension("@rules_android//rules/android_sdk_repository:rule.bzl", "android_sdk_repository_extension", dev_dependency = True)

override_repo(rules_android_sdk, "androidsdk")

register_toolchains(
    "@androidsdk//:all",
    dev_dependency = True,
)

robolectric_repo = use_extension("@robolectric_repo//bazel:extensions.bzl", "robolectric_repository_extensions")

# Deliberately request versions out of catalog order.
robolectric_repo.configure(versions = [
    "15-robolectric-13954326-i7",
    "14-robolectric-10818077-i7",
])

# Independent single-SDK setups coexist with the two-SDK default above.
robolectric_repo.configure(
    name = "android_14",
    versions = ["14-robolectric-10818077-i7"],
)
robolectric_repo.configure(
    name = "android_15",
    versions = ["15-robolectric-13954326-i7"],
)
use_repo(robolectric_repo, "android_14", "android_15")
