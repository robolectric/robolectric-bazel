"""A dependency's settings must not override the end user's selection."""

module(
    name = "selection_dependency",
    version = "0.0.0",
)

bazel_dep(name = "rules_robolectric", version = "0.0.0", repo_name = "robolectric")

robolectric_repo = use_extension("@robolectric//bazel:extensions.bzl", "robolectric_repository_extensions")
robolectric_repo.configure(versions = ["ignored-in-dependency"])
